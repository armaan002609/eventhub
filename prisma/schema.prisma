generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COORDINATOR
  VOLUNTEER
  PARTICIPANT
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  WAIVED
}

enum IdProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DutyLevel {
  HIGH_LEVEL // Super Admin -> Coordinator
  TASK       // Coordinator -> Volunteer
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum ScoreMetric {
  TIME_MS_ASC // lower is better (timed events)
  POINTS_DESC // higher is better
}

enum SportType {
  CRICKET
  FOOTBALL
  BADMINTON
  WRESTLING
  CANOEING
}

enum MatchStatus {
  UPCOMING
  LIVE
  PAUSED
  COMPLETED
}

model University {
  id            String         @id @default(cuid())
  uid           String         @unique // College/University UID used for coordinator assignment
  name          String
  users         User[]
  registrations Registration[]
  duties        Duty[]
  createdAt     DateTime       @default(now())
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(PARTICIPANT)
  isActive     Boolean     @default(true)
  tokenVersion Int         @default(0) // bump to revoke every issued JWT for this user
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  registrations    Registration[]
  dutiesCreated    Duty[]          @relation("DutyCreator")
  dutiesAssigned   Duty[]          @relation("DutyAssignee")
  attendance       AttendanceLog[] @relation("AttendanceVolunteer")
  attendanceMarked AttendanceLog[] @relation("AttendanceMarker")
  scoresUpdated    ScoreEntry[]
  auditLogs        AuditLog[]
  matchLogs        MatchLog[]
  messagesSent     ChatMessage[]   @relation("ChatSent")
  messagesReceived ChatMessage[]   @relation("ChatReceived")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, universityId])
}

model BoardingPoint {
  id            String         @id @default(cuid())
  name          String         @unique
  charge        Int // INR, integer rupees
  isActive      Boolean        @default(true)
  registrations Registration[]
}

model Registration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  teamName    String?
  teamMembers String?

  // Basic info
  studentName  String
  phone        String
  email        String
  universityId String
  university   University @relation(fields: [universityId], references: [id])

  // ID proof: private storage object path, NEVER a public URL
  idProofPath   String
  idProofStatus IdProofStatus @default(PENDING)

  // Transport
  needsTransport  Boolean        @default(false)
  boardingPointId String?
  boardingPoint   BoardingPoint? @relation(fields: [boardingPointId], references: [id])
  transportFee    Int            @default(0)

  // Accommodation
  needsAccommodation Boolean   @default(false)
  accommodationDays  Int?
  checkIn            DateTime?
  checkOut           DateTime?
  accommodationFee   Int       @default(0)

  // Food
  needsFood   Boolean @default(false)
  mealsPerDay Int?
  foodFee     Int     @default(0)

  // Fees: always computed server-side
  totalFee      Int           @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@index([paymentStatus])
  @@unique([userId, hackathonId])
}

model Duty {
  id           String      @id @default(cuid())
  level        DutyLevel
  title        String
  description  String?
  venue        String
  startsAt     DateTime
  endsAt       DateTime
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  createdById  String
  createdBy    User        @relation("DutyCreator", fields: [createdById], references: [id])
  assignedToId String
  assignedTo   User        @relation("DutyAssignee", fields: [assignedToId], references: [id])
  attendance   AttendanceLog[]
  createdAt    DateTime    @default(now())

  @@index([assignedToId, startsAt])
}

model AttendanceLog {
  id          String           @id @default(cuid())
  dutyId      String
  duty        Duty             @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   User             @relation("AttendanceVolunteer", fields: [volunteerId], references: [id])
  status      AttendanceStatus
  markedAt    DateTime         @default(now()) // exact timestamp of the mark
  markedById  String
  markedBy    User             @relation("AttendanceMarker", fields: [markedById], references: [id])
  note        String?

  @@index([dutyId, volunteerId, markedAt])
}

model Competition {
  id          String       @id @default(cuid())
  name        String
  metric      ScoreMetric
  unit        String?
  isPublished Boolean      @default(false)
  entries     ScoreEntry[]
  createdAt   DateTime     @default(now())
}

model ScoreEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamName      String
  participantId String?
  timeMs        Int?
  points        Int?
  metrics       Json? // event-specific extras
  updatedById   String
  updatedBy     User        @relation(fields: [updatedById], references: [id])
  updatedAt     DateTime    @updatedAt

  // Rank is computed at read time (ORDER BY per competition.metric), never stored, so it can't go stale.
  @@unique([competitionId, teamName])
  @@index([competitionId, points])
  @@index([competitionId, timeMs])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // e.g. IDPROOF_VIEWED, COORDINATOR_ASSIGNED
  target    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model Hackathon {
  id          String   @id @default(cuid())
  title       String
  organizer   String
  location    String
  themes      String[]
  prizeText   String?
  startsAt    DateTime
  endsAt      DateTime
  participants Int     @default(0)
  isPublished Boolean  @default(true)
  imagePath   String?
  logoPath    String?
  eventType   String   @default("Event")

  // Registration Fees
  baseFee          Int @default(500)
  transportFee     Int @default(350)
  accommodationFee Int @default(1500)
  foodFee          Int @default(900)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  committees  Committee[]
  registrations Registration[]
  matches     Match[]
}

model Committee {
  id              String   @id @default(cuid())
  hackathonId     String
  committeeName   String
  inCharge        String
  contactDetails  String?
  responsibility  String?
  duty            String?
  venue           String?
  remarks         String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  hackathon       Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
}

model Match {
  id          String      @id @default(cuid())
  title       String      // e.g. "Finals: Team A vs Team B"
  sport       SportType
  status      MatchStatus @default(UPCOMING)
  
  startTime   DateTime?
  endTime     DateTime?
  
  // JSON field for sport-specific state
  scoreData   Json        @default("{}")
  
  hackathonId String?
  hackathon   Hackathon?  @relation(fields: [hackathonId], references: [id])
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  logs        MatchLog[]
}

model MatchLog {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  action      String   
  payload     Json?    
  
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("ChatSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ChatReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([createdAt])
}
